{
  "name": "simple-snip",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "eslint extension tests eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm test && python3 scripts/check-package.py",
    "package": "python3 scripts/package.py && python3 scripts/package-source.py"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.4.0",
    "prettier": "3.9.9"
  }
}
