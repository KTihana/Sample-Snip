{
  "manifest_version": 3,
  "name": "Simple Snip",
  "version": "0.3.2",
  "description": "Record short audio samples from a browser tab, preview them, and download WAV or MP3 files.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "activeTab", "sidePanel"],
  "background": {
    "service_worker": "chrome/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "Simple Snip"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "ui/popup.html?panel=1"
  }
}
