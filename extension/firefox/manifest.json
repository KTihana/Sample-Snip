{
  "manifest_version": 2,
  "name": "Simple Snip \u2014 Firefox beta",
  "version": "0.3.2",
  "description": "Sample audio from supported audio/video players in the selected page. Preview and download WAV or MP3 locally.",
  "permissions": ["activeTab"],
  "background": {
    "page": "firefox/background.html",
    "persistent": true
  },
  "browser_action": {
    "default_popup": "ui/popup.html",
    "default_title": "Simple Snip"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sample-snip-test@sample-snip.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "sidebar_action": {
    "default_panel": "ui/popup.html?panel=1",
    "default_title": "Simple Snip",
    "default_icon": "icons/icon-32.png"
  },
  "web_accessible_resources": ["firefox/page-recorder.js"]
}
